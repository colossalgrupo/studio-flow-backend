# MongoDB
MONGODB_URI=mongodb://localhost:27017/studio-schedulle-db

# JWT
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
JWT_EXPIRATION_MS=86400000

# HTTP
PORT=8080

# CORS — origens de navegador liberadas (lista separada por vírgula).
# O app Android não é afetado por CORS.
CORS_ALLOWED_ORIGINS=https://studioschedulle.com.br,https://www.studioschedulle.com.br,https://app.studioschedulle.com.br,http://localhost:3000,http://localhost:5173

# E-mail transacional (Resend — https://resend.com)
# Sem RESEND_API_KEY, o envio de e-mails é ignorado (com log de aviso) e o
# cadastro/reset de senha continuam funcionando normalmente, só sem e-mail.
RESEND_API_KEY=
# Precisa ser um remetente de um domínio verificado no Resend.
EMAIL_FROM=Studio Schedulle <naoresponda@studioschedulle.com.br>

# URL do frontend (studio-flow-web) usada nos links de verificação de e-mail
# e redefinição de senha enviados por e-mail.
FRONTEND_URL=https://app.studioschedulle.com.br
